# BuildShare v0.1 - example environment. No secrets in this file.
#
# Only VITE_* variables reach the browser bundle, and only public values may
# ever be placed here. NEVER add VITE_AI_API_KEY, VITE_GITHUB_PRIVATE_KEY or
# VITE_DATABASE_URL: anything with a VITE_ prefix is public.

# --- Frontend (public) ---------------------------------------------------
# devnet | mainnet-beta
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# The deployed BuildShare Anchor program id (P1).
# Leave EMPTY until the program is really deployed. Live mode stays disabled
# while this is empty; it never falls back to the demo provider.
# The System Program (11111111111111111111111111111111) is rejected.
VITE_PROGRAM_ID=

# --- Backend (server only, P2+) ------------------------------------------
# These are NOT read by the frontend and must never be prefixed with VITE_.
# DATABASE_URL=postgresql://user:password@localhost:5432/buildshare
# SOLANA_NETWORK=devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com
# PROGRAM_ID=
# GITHUB_APP_ID=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_PRIVATE_KEY=
# AI_API_KEY=
# SESSION_SECRET=
# DEMO_MODE=true
